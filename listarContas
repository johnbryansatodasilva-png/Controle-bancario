#include <stdio.h>
#include <stdlib.h>
#include "funcoes.h"

void listarContas(void) {
    CONTA *aux = inicio;
    int linha;
    int quantidade;

    if (inicio == NULL) {
        system("cls");

        gotoxy(22, 14);
        printf("Nenhuma conta cadastrada!");

        gotoxy(20, 27);
        printf("Pressione ENTER para continuar...");
        getchar();
        getchar();
        return;
    }

    while (aux != NULL) {
        system("cls");

        for (int x = 3; x <= 78; x++) {
            gotoxy(x, 3);
            printf("-");
            gotoxy(x, 27);
            printf("-");
        }

        for (int y = 3; y <= 27; y++) {
            gotoxy(3, y);
            printf("|");
            gotoxy(78, y);
            printf("|");
        }

        gotoxy(30, 5);
        printf("LISTAGEM DE CONTAS");

        gotoxy(5, 8);
        printf("COD  BANCO       AGENCIA  NUMERO    TIPO      SALDO      LIMITE    STATUS");

        linha = 10;
        quantidade = 0;

        while (aux != NULL && quantidade < 15) {
            gotoxy(5, linha);
            printf("%-4d %-11.11s %-8d %-9d %-9.9s %9.2f %9.2f %-8s",
                   aux->codigo,
                   aux->banco,
                   aux->agencia,
                   aux->numeroConta,
                   aux->tipo,
                   aux->saldo,
                   aux->limite,
                   aux->status == 1 ? "Ativa" : "Inativa");

            aux = aux->prox;
            linha++;
            quantidade++;
        }

        if (aux != NULL) {
            gotoxy(15, 25);
            printf("Pressione ENTER para ver mais contas...");
            getchar();
            getchar();
        } else {
            gotoxy(20, 25);
            printf("Fim da listagem.");

            gotoxy(20, 29);
            printf("Pressione ENTER para continuar...");
            getchar();
            getchar();
        }
    }
}
