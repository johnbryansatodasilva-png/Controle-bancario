
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Sistema Bancario",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-g3",
                "main.c",
                "menu.c",
                "cadastrarConta.c",
                "inserirFinal.c",
                "inserirPosicao.c",
                "consultarConta.c",
                "movimentacao.c",
                "alterarConta.c",
                "gotoxy.c",
                "excluirConta.c",
                "relatorios.c",
                "transferencia.c",
                "arquivosSalvar.c",
                "-o",
                "output/Banco.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
